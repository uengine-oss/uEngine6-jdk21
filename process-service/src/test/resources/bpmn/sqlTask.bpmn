<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:uengine="http://uengine"
                  id="Definitions_SQLTask"
                  name="test/sqlTask"
                  targetNamespace="http://uengine/test">

  <bpmn:process id="Process_SQLTask" name="sqlTask" isExecutable="true">
    <bpmn:extensionElements>
      <uengine:properties json="{&quot;definitionName&quot;:&quot;test/sqlTask&quot;,&quot;version&quot;:&quot;1.0&quot;}">
        <uengine:variable name="customerId" type="Text" />
        <uengine:variable name="customerName" type="Text" />
        <uengine:variable name="creditLimit" type="Number" />
      </uengine:properties>
    </bpmn:extensionElements>

    <bpmn:startEvent id="Start_1" name="시작">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- SQLTask, DirectSQLStrategy(기본): 모델러가 SQL 을 직접 작성 -->
    <bpmn:serviceTask id="SQLTask_Insert" name="고객 등록">
      <bpmn:extensionElements>
        <uengine:properties>
          <uengine:json>
            {
              "_type": "org.uengine.kernel.bpmn.SQLTask",
              "connectionFactory": {
                "_type": "org.uengine.util.dao.JDBCConnectionFactory",
                "driverClass": "org.h2.Driver",
                "connectionString": "jdbc:h2:mem:sqltaskmodeling;DB_CLOSE_DELAY=-1",
                "userId": "sa",
                "password": ""
              },
              "sqlStmt": "insert into CUSTOMER (ID, NAME, CREDIT_LIMIT) values (?, upper(?), ?)",
              "parameters": [
                {"argument": {"text": "ID"}, "variable": {"name": "customerId"}},
                {"argument": {"text": "NAME"}, "variable": {"name": "customerName"}},
                {"argument": {"text": "CREDIT_LIMIT"}, "variable": {"name": "creditLimit"}}
              ]
            }
          </uengine:json>
        </uengine:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- 같은 SQLTask 이지만 DatabaseMappingStrategy 로 설정: SQL 없이 컬럼 매핑만 -->
    <bpmn:serviceTask id="SQLTask_SelectByMapping" name="고객 조회">
      <bpmn:extensionElements>
        <uengine:properties>
          <uengine:json>
            {
              "_type": "org.uengine.kernel.bpmn.SQLTask",
              "connectionFactory": {
                "_type": "org.uengine.util.dao.JDBCConnectionFactory",
                "driverClass": "org.h2.Driver",
                "connectionString": "jdbc:h2:mem:sqltaskmodeling;DB_CLOSE_DELAY=-1",
                "userId": "sa",
                "password": ""
              },
              "strategy": {
                "_type": "org.uengine.kernel.bpmn.sql.DatabaseMappingStrategy",
                "queryMode": "SELECT",
                "mappingContext": {
                  "mappingElements": [
                    {"argument": {"text": "CUSTOMER.ID"}, "variable": {"name": "customerId"}, "isKey": true},
                    {"argument": {"text": "CUSTOMER.NAME"}, "variable": {"name": "customerName"}},
                    {"argument": {"text": "CUSTOMER.CREDIT_LIMIT"}, "variable": {"name": "creditLimit"}}
                  ]
                }
              }
            }
          </uengine:json>
        </uengine:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_1" name="종료">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="SQLTask_Insert" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="SQLTask_Insert" targetRef="SQLTask_SelectByMapping" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="SQLTask_SelectByMapping" targetRef="End_1" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_SQLTask">
      <bpmndi:BPMNShape id="Start_1_di" bpmnElement="Start_1">
        <dc:Bounds x="160" y="160" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SQLTask_Insert_di" bpmnElement="SQLTask_Insert">
        <dc:Bounds x="250" y="138" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SQLTask_SelectByMapping_di" bpmnElement="SQLTask_SelectByMapping">
        <dc:Bounds x="410" y="138" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_1_di" bpmnElement="End_1">
        <dc:Bounds x="572" y="160" width="36" height="36" />
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
