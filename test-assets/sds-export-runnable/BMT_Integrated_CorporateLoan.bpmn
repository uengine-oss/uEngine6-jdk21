<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:uengine="http://uengine" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_BMT_Integrated_CorporateLoan" targetNamespace="http://uengine.org/sds/bmt">
  <bpmn:collaboration id="Collaboration_BMT_Integrated_CorporateLoan">
    <bpmn:participant id="Participant_BMT_Integrated_CorporateLoan" name="BMT 통합 기업여신 실행검증" processRef="Process_BMT_Integrated_CorporateLoan">
      <bpmn:extensionElements>
        <uengine:properties json="{}" />
      </bpmn:extensionElements>
    </bpmn:participant>
  </bpmn:collaboration>
  <bpmn:process id="Process_BMT_Integrated_CorporateLoan" name="BMT 통합 기업여신 실행검증" isExecutable="true">
    <bpmn:extensionElements>
      <uengine:properties json="{&quot;definitionName&quot;:&quot;BMT 통합 기업여신 실행검증&quot;,&quot;version&quot;:&quot;1.0&quot;}">
        <uengine:variable name="documentReady" type="Text" displayName="서류완비여부" />
        <uengine:variable name="reviewResult" type="Text" displayName="심사결과" />
        <uengine:variable name="hqResult" type="Text" displayName="본부승인결과" />
        <uengine:variable name="complianceResult" type="Text" displayName="준법승인결과" />
        <uengine:variable name="executionResult" type="Text" displayName="여신실행결과" />
      </uengine:properties>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_BMT_Integrated">
      <bpmn:lane id="Lane_Branch" name="영업점">
        <bpmn:extensionElements>
          <uengine:properties json="{&quot;role&quot;:&quot;user&quot;,&quot;dispatchingOption&quot;:1,&quot;roleResolutionContext&quot;:{&quot;_type&quot;:&quot;org.uengine.hwlife.overriding.BoundRoleResolutionContext&quot;,&quot;base&quot;:{&quot;_type&quot;:&quot;org.uengine.five.overriding.IAMRoleResolutionContext&quot;,&quot;scope&quot;:&quot;user&quot;},&quot;bindings&quot;:{}}}" />
        </bpmn:extensionElements>
<bpmn:flowNodeRef>Start_Integrated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Application</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DocumentReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DocumentReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SupplementRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ResubmitDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RejectNotice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_External" name="외부시스템">
        <bpmn:extensionElements>
          <uengine:properties json="{&quot;role&quot;:&quot;user&quot;,&quot;dispatchingOption&quot;:1,&quot;roleResolutionContext&quot;:{&quot;_type&quot;:&quot;org.uengine.hwlife.overriding.BoundRoleResolutionContext&quot;,&quot;base&quot;:{&quot;_type&quot;:&quot;org.uengine.five.overriding.IAMRoleResolutionContext&quot;,&quot;scope&quot;:&quot;user&quot;},&quot;bindings&quot;:{}}}" />
        </bpmn:extensionElements>
<bpmn:flowNodeRef>Gateway_PreCheckSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IdentityInquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CollateralInquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PreCheckJoin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Credit" name="여신심사부">
        <bpmn:extensionElements>
          <uengine:properties json="{&quot;role&quot;:&quot;user&quot;,&quot;dispatchingOption&quot;:1,&quot;roleResolutionContext&quot;:{&quot;_type&quot;:&quot;org.uengine.hwlife.overriding.BoundRoleResolutionContext&quot;,&quot;base&quot;:{&quot;_type&quot;:&quot;org.uengine.five.overriding.IAMRoleResolutionContext&quot;,&quot;scope&quot;:&quot;user&quot;},&quot;bindings&quot;:{}}}" />
        </bpmn:extensionElements>
<bpmn:flowNodeRef>Call_CreditEval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreditReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReviewResult</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Approval" name="승인권자">
        <bpmn:extensionElements>
          <uengine:properties json="{&quot;role&quot;:&quot;user&quot;,&quot;dispatchingOption&quot;:1,&quot;roleResolutionContext&quot;:{&quot;_type&quot;:&quot;org.uengine.hwlife.overriding.BoundRoleResolutionContext&quot;,&quot;base&quot;:{&quot;_type&quot;:&quot;org.uengine.five.overriding.IAMRoleResolutionContext&quot;,&quot;scope&quot;:&quot;user&quot;},&quot;bindings&quot;:{}}}" />
        </bpmn:extensionElements>
<bpmn:flowNodeRef>Gateway_ApprovalSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HQApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ComplianceApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ApprovalJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ApprovalResult</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Operation" name="여신운영">
        <bpmn:extensionElements>
          <uengine:properties json="{&quot;role&quot;:&quot;user&quot;,&quot;dispatchingOption&quot;:1,&quot;roleResolutionContext&quot;:{&quot;_type&quot;:&quot;org.uengine.hwlife.overriding.BoundRoleResolutionContext&quot;,&quot;base&quot;:{&quot;_type&quot;:&quot;org.uengine.five.overriding.IAMRoleResolutionContext&quot;,&quot;scope&quot;:&quot;user&quot;},&quot;bindings&quot;:{}}}" />
        </bpmn:extensionElements>
<bpmn:flowNodeRef>Task_ContractPrepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LoanExecution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ExecutionResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExecutionRetry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Completed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_Integrated" name="여신신청 시작"><bpmn:outgoing>Flow_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="Task_Application" name="여신 신청 접수">
      <bpmn:extensionElements><uengine:properties json="{&quot;role&quot;:&quot;user&quot;,&quot;process&quot;:&quot;Process_BMT_Integrated_CorporateLoan&quot;,&quot;tool&quot;:&quot;formHandler:BMT_Int_Application&quot;,&quot;duration&quot;:5,&quot;inputData&quot;:[],&quot;outputData&quot;:[],&quot;eventSynchronization&quot;:{&quot;eventType&quot;:&quot;&quot;,&quot;attributes&quot;:[],&quot;mappingContext&quot;:{&quot;mappingElements&quot;:[]}}}" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_01</bpmn:incoming><bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_DocumentReview" name="신청서류 검토">
      <bpmn:extensionElements><uengine:properties json="{&quot;role&quot;:&quot;user&quot;,&quot;process&quot;:&quot;Process_BMT_Integrated_CorporateLoan&quot;,&quot;tool&quot;:&quot;formHandler:BMT_Int_DocumentReview&quot;,&quot;duration&quot;:5,&quot;inputData&quot;:[],&quot;outputData&quot;:[],&quot;eventSynchronization&quot;:{&quot;eventType&quot;:&quot;&quot;,&quot;attributes&quot;:[],&quot;mappingContext&quot;:{&quot;mappingElements&quot;:[{&quot;argument&quot;:{&quot;text&quot;:&quot;documentReady&quot;},&quot;direction&quot;:&quot;out&quot;,&quot;variable&quot;:{&quot;name&quot;:&quot;[Arguments].documentReady&quot;},&quot;isKey&quot;:false}]}}}" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_02</bpmn:incoming><bpmn:incoming>Flow_06</bpmn:incoming><bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_DocumentReady" name="서류완비?"><bpmn:incoming>Flow_03</bpmn:incoming><bpmn:outgoing>Flow_04</bpmn:outgoing><bpmn:outgoing>Flow_05</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_SupplementRequest" name="보완 요청">
      <bpmn:extensionElements><uengine:properties json="{&quot;role&quot;:&quot;user&quot;,&quot;process&quot;:&quot;Process_BMT_Integrated_CorporateLoan&quot;,&quot;tool&quot;:&quot;formHandler:BMT_Int_SupplementRequest&quot;,&quot;duration&quot;:5,&quot;inputData&quot;:[],&quot;outputData&quot;:[],&quot;eventSynchronization&quot;:{&quot;eventType&quot;:&quot;&quot;,&quot;attributes&quot;:[],&quot;mappingContext&quot;:{&quot;mappingElements&quot;:[]}}}" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_05</bpmn:incoming><bpmn:incoming>Flow_18</bpmn:incoming><bpmn:outgoing>Flow_06A</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ResubmitDocuments" name="보완서류 재접수">
      <bpmn:extensionElements><uengine:properties json="{&quot;role&quot;:&quot;user&quot;,&quot;process&quot;:&quot;Process_BMT_Integrated_CorporateLoan&quot;,&quot;tool&quot;:&quot;formHandler:BMT_Int_ResubmitDocuments&quot;,&quot;duration&quot;:5,&quot;inputData&quot;:[],&quot;outputData&quot;:[],&quot;eventSynchronization&quot;:{&quot;eventType&quot;:&quot;&quot;,&quot;attributes&quot;:[],&quot;mappingContext&quot;:{&quot;mappingElements&quot;:[]}}}" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_06A</bpmn:incoming><bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:parallelGateway id="Gateway_PreCheckSplit" name="사전조회 분기"><bpmn:incoming>Flow_04</bpmn:incoming><bpmn:outgoing>Flow_07</bpmn:outgoing><bpmn:outgoing>Flow_08</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:userTask id="Task_IdentityInquiry" name="본인확인 연계결과 확인">
      <bpmn:extensionElements><uengine:properties json="{&quot;role&quot;:&quot;user&quot;,&quot;process&quot;:&quot;Process_BMT_Integrated_CorporateLoan&quot;,&quot;tool&quot;:&quot;formHandler:BMT_Int_IdentityInquiry&quot;,&quot;duration&quot;:5,&quot;inputData&quot;:[],&quot;outputData&quot;:[],&quot;eventSynchronization&quot;:{&quot;eventType&quot;:&quot;&quot;,&quot;attributes&quot;:[],&quot;mappingContext&quot;:{&quot;mappingElements&quot;:[]}}}" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_07</bpmn:incoming><bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_CollateralInquiry" name="담보조회 연계결과 확인">
      <bpmn:extensionElements><uengine:properties json="{&quot;role&quot;:&quot;user&quot;,&quot;process&quot;:&quot;Process_BMT_Integrated_CorporateLoan&quot;,&quot;tool&quot;:&quot;formHandler:BMT_Int_CollateralInquiry&quot;,&quot;duration&quot;:5,&quot;inputData&quot;:[],&quot;outputData&quot;:[],&quot;eventSynchronization&quot;:{&quot;eventType&quot;:&quot;&quot;,&quot;attributes&quot;:[],&quot;mappingContext&quot;:{&quot;mappingElements&quot;:[]}}}" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_08</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="Gateway_PreCheckJoin" name="사전조회 합류"><bpmn:incoming>Flow_09</bpmn:incoming><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:parallelGateway>

    <bpmn:callActivity id="Call_CreditEval" name="공통 기업신용평가 호출" calledElement="BMT_CorporateCreditEval_Sub">
      <bpmn:extensionElements><uengine:properties json="{&quot;role&quot;:&quot;user&quot;,&quot;process&quot;:&quot;Process_BMT_Integrated_CorporateLoan&quot;,&quot;definitionId&quot;:&quot;BMT_CorporateCreditEval_Sub.bpmn&quot;,&quot;version&quot;:&quot;1.0&quot;,&quot;duration&quot;:5,&quot;inputData&quot;:[],&quot;outputData&quot;:[],&quot;variableBindings&quot;:[],&quot;roleBindings&quot;:[]}" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:userTask id="Task_CreditReview" name="여신 심사 판정">
      <bpmn:extensionElements><uengine:properties json="{&quot;role&quot;:&quot;user&quot;,&quot;process&quot;:&quot;Process_BMT_Integrated_CorporateLoan&quot;,&quot;tool&quot;:&quot;formHandler:BMT_Int_CreditReview&quot;,&quot;duration&quot;:5,&quot;inputData&quot;:[],&quot;outputData&quot;:[],&quot;eventSynchronization&quot;:{&quot;eventType&quot;:&quot;&quot;,&quot;attributes&quot;:[],&quot;mappingContext&quot;:{&quot;mappingElements&quot;:[{&quot;argument&quot;:{&quot;text&quot;:&quot;reviewResult&quot;},&quot;direction&quot;:&quot;out&quot;,&quot;variable&quot;:{&quot;name&quot;:&quot;[Arguments].reviewResult&quot;},&quot;isKey&quot;:false}]}}}" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ReviewResult" name="심사결과"><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_14</bpmn:outgoing><bpmn:outgoing>Flow_18</bpmn:outgoing><bpmn:outgoing>Flow_19</bpmn:outgoing></bpmn:exclusiveGateway>

    <bpmn:parallelGateway id="Gateway_ApprovalSplit" name="병렬승인 분기"><bpmn:incoming>Flow_14</bpmn:incoming><bpmn:outgoing>Flow_15</bpmn:outgoing><bpmn:outgoing>Flow_16</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:userTask id="Task_HQApproval" name="본부 승인">
      <bpmn:extensionElements><uengine:properties json="{&quot;role&quot;:&quot;user&quot;,&quot;process&quot;:&quot;Process_BMT_Integrated_CorporateLoan&quot;,&quot;tool&quot;:&quot;formHandler:BMT_Int_HQApproval&quot;,&quot;duration&quot;:5,&quot;inputData&quot;:[],&quot;outputData&quot;:[],&quot;eventSynchronization&quot;:{&quot;eventType&quot;:&quot;&quot;,&quot;attributes&quot;:[],&quot;mappingContext&quot;:{&quot;mappingElements&quot;:[{&quot;argument&quot;:{&quot;text&quot;:&quot;hqResult&quot;},&quot;direction&quot;:&quot;out&quot;,&quot;variable&quot;:{&quot;name&quot;:&quot;[Arguments].hqResult&quot;},&quot;isKey&quot;:false}]}}}" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_15</bpmn:incoming><bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ComplianceApproval" name="준법 승인">
      <bpmn:extensionElements><uengine:properties json="{&quot;role&quot;:&quot;user&quot;,&quot;process&quot;:&quot;Process_BMT_Integrated_CorporateLoan&quot;,&quot;tool&quot;:&quot;formHandler:BMT_Int_ComplianceApproval&quot;,&quot;duration&quot;:5,&quot;inputData&quot;:[],&quot;outputData&quot;:[],&quot;eventSynchronization&quot;:{&quot;eventType&quot;:&quot;&quot;,&quot;attributes&quot;:[],&quot;mappingContext&quot;:{&quot;mappingElements&quot;:[{&quot;argument&quot;:{&quot;text&quot;:&quot;complianceResult&quot;},&quot;direction&quot;:&quot;out&quot;,&quot;variable&quot;:{&quot;name&quot;:&quot;[Arguments].complianceResult&quot;},&quot;isKey&quot;:false}]}}}" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_16</bpmn:incoming><bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="Gateway_ApprovalJoin" name="병렬승인 합류"><bpmn:incoming>Flow_20</bpmn:incoming><bpmn:incoming>Flow_21</bpmn:incoming><bpmn:outgoing>Flow_22</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="Gateway_ApprovalResult" name="승인결과"><bpmn:incoming>Flow_22</bpmn:incoming><bpmn:outgoing>Flow_23</bpmn:outgoing><bpmn:outgoing>Flow_24</bpmn:outgoing></bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_ContractPrepare" name="약정 및 실행 준비">
      <bpmn:extensionElements><uengine:properties json="{&quot;role&quot;:&quot;user&quot;,&quot;process&quot;:&quot;Process_BMT_Integrated_CorporateLoan&quot;,&quot;tool&quot;:&quot;formHandler:BMT_Int_ContractPrepare&quot;,&quot;duration&quot;:5,&quot;inputData&quot;:[],&quot;outputData&quot;:[],&quot;eventSynchronization&quot;:{&quot;eventType&quot;:&quot;&quot;,&quot;attributes&quot;:[],&quot;mappingContext&quot;:{&quot;mappingElements&quot;:[]}}}" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_23</bpmn:incoming><bpmn:incoming>Flow_28</bpmn:incoming><bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_LoanExecution" name="여신 실행 결과 등록">
      <bpmn:extensionElements><uengine:properties json="{&quot;role&quot;:&quot;user&quot;,&quot;process&quot;:&quot;Process_BMT_Integrated_CorporateLoan&quot;,&quot;tool&quot;:&quot;formHandler:BMT_Int_LoanExecution&quot;,&quot;duration&quot;:5,&quot;inputData&quot;:[],&quot;outputData&quot;:[],&quot;eventSynchronization&quot;:{&quot;eventType&quot;:&quot;&quot;,&quot;attributes&quot;:[],&quot;mappingContext&quot;:{&quot;mappingElements&quot;:[{&quot;argument&quot;:{&quot;text&quot;:&quot;executionResult&quot;},&quot;direction&quot;:&quot;out&quot;,&quot;variable&quot;:{&quot;name&quot;:&quot;[Arguments].executionResult&quot;},&quot;isKey&quot;:false}]}}}" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_25</bpmn:incoming><bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ExecutionResult" name="실행결과"><bpmn:incoming>Flow_26</bpmn:incoming><bpmn:outgoing>Flow_27</bpmn:outgoing><bpmn:outgoing>Flow_28A</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ExecutionRetry" name="실행 실패 재처리">
      <bpmn:extensionElements><uengine:properties json="{&quot;role&quot;:&quot;user&quot;,&quot;process&quot;:&quot;Process_BMT_Integrated_CorporateLoan&quot;,&quot;tool&quot;:&quot;formHandler:BMT_Int_ExecutionRetry&quot;,&quot;duration&quot;:5,&quot;inputData&quot;:[],&quot;outputData&quot;:[],&quot;eventSynchronization&quot;:{&quot;eventType&quot;:&quot;&quot;,&quot;attributes&quot;:[],&quot;mappingContext&quot;:{&quot;mappingElements&quot;:[]}}}" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_28A</bpmn:incoming><bpmn:outgoing>Flow_28</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_RejectNotice" name="반려 통보">
      <bpmn:extensionElements><uengine:properties json="{&quot;role&quot;:&quot;user&quot;,&quot;process&quot;:&quot;Process_BMT_Integrated_CorporateLoan&quot;,&quot;tool&quot;:&quot;formHandler:BMT_Int_RejectNotice&quot;,&quot;duration&quot;:5,&quot;inputData&quot;:[],&quot;outputData&quot;:[],&quot;eventSynchronization&quot;:{&quot;eventType&quot;:&quot;&quot;,&quot;attributes&quot;:[],&quot;mappingContext&quot;:{&quot;mappingElements&quot;:[]}}}" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_19</bpmn:incoming><bpmn:incoming>Flow_24</bpmn:incoming><bpmn:outgoing>Flow_29</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Rejected" name="반려 종료"><bpmn:incoming>Flow_29</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="End_Completed" name="여신 실행 완료"><bpmn:incoming>Flow_27</bpmn:incoming></bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_Integrated" targetRef="Task_Application" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_Application" targetRef="Task_DocumentReview" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_DocumentReview" targetRef="Gateway_DocumentReady" />
    <bpmn:sequenceFlow id="Flow_04" name="Y" sourceRef="Gateway_DocumentReady" targetRef="Gateway_PreCheckSplit"><bpmn:extensionElements><uengine:properties json="{&quot;condition&quot;:{&quot;_type&quot;:&quot;org.uengine.kernel.Evaluate&quot;,&quot;key&quot;:&quot;documentReady&quot;,&quot;value&quot;:&quot;Y&quot;}}" /></bpmn:extensionElements><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${documentReady == "Y"}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_05" name="N" sourceRef="Gateway_DocumentReady" targetRef="Task_SupplementRequest"><bpmn:extensionElements><uengine:properties json="{&quot;condition&quot;:{&quot;_type&quot;:&quot;org.uengine.kernel.Evaluate&quot;,&quot;key&quot;:&quot;documentReady&quot;,&quot;value&quot;:&quot;N&quot;}}" /></bpmn:extensionElements><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${documentReady == "N"}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_06A" sourceRef="Task_SupplementRequest" targetRef="Task_ResubmitDocuments" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_ResubmitDocuments" targetRef="Task_DocumentReview" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Gateway_PreCheckSplit" targetRef="Task_IdentityInquiry" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Gateway_PreCheckSplit" targetRef="Task_CollateralInquiry" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_IdentityInquiry" targetRef="Gateway_PreCheckJoin" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_CollateralInquiry" targetRef="Gateway_PreCheckJoin" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Gateway_PreCheckJoin" targetRef="Call_CreditEval" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Call_CreditEval" targetRef="Task_CreditReview" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_CreditReview" targetRef="Gateway_ReviewResult" />
