    <bpmn:sequenceFlow id="Flow_18" name="보완" sourceRef="Gateway_ReviewResult" targetRef="Task_SupplementRequest"><bpmn:extensionElements><uengine:properties json="{&quot;condition&quot;:{&quot;_type&quot;:&quot;org.uengine.kernel.Evaluate&quot;,&quot;key&quot;:&quot;reviewResult&quot;,&quot;value&quot;:&quot;보완&quot;}}" /></bpmn:extensionElements><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${reviewResult == "보완"}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_19" name="반려" sourceRef="Gateway_ReviewResult" targetRef="Task_RejectNotice"><bpmn:extensionElements><uengine:properties json="{&quot;condition&quot;:{&quot;_type&quot;:&quot;org.uengine.kernel.Evaluate&quot;,&quot;key&quot;:&quot;reviewResult&quot;,&quot;value&quot;:&quot;반려&quot;}}" /></bpmn:extensionElements><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${reviewResult == "반려"}</bpmn:conditionExpression></bpmn:sequenceFlow>
