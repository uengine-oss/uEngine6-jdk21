    <bpmn:sequenceFlow id="Flow_24" name="반려 있음" sourceRef="Gateway_ApprovalResult" targetRef="Task_RejectNotice"><bpmn:extensionElements><uengine:properties json="{&quot;condition&quot;:{&quot;_type&quot;:&quot;org.uengine.kernel.Or&quot;,&quot;conditionsVt&quot;:[{&quot;_type&quot;:&quot;org.uengine.kernel.Evaluate&quot;,&quot;key&quot;:&quot;hqResult&quot;,&quot;value&quot;:&quot;반려&quot;},{&quot;_type&quot;:&quot;org.uengine.kernel.Evaluate&quot;,&quot;key&quot;:&quot;complianceResult&quot;,&quot;value&quot;:&quot;반려&quot;}]}}" /></bpmn:extensionElements><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${hqResult == "반려" || complianceResult == "반려"}</bpmn:conditionExpression></bpmn:sequenceFlow>
