      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_A01" sourceRef="Start_Account" targetRef="Task_AccountConsult" />
    <bpmn:sequenceFlow id="Flow_A02" sourceRef="Task_AccountConsult" targetRef="Gw_NewCustomer" />
    <bpmn:sequenceFlow id="Flow_A03" sourceRef="Gw_NewCustomer" targetRef="Svc_PhoneAuth" name="Y">
      <bpmn:extensionElements>
        <uengine:properties json="{&quot;condition&quot;:{&quot;_type&quot;:&quot;org.uengine.kernel.Evaluate&quot;,&quot;key&quot;:&quot;신규고객여부&quot;,&quot;value&quot;:&quot;Y&quot;}}" />
      </bpmn:extensionElements>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${신규고객여부 == "Y"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_A04" sourceRef="Gw_NewCustomer" targetRef="Task_PrivacyConsent" name="N">
      <bpmn:extensionElements>
