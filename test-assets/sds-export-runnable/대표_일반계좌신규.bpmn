        <uengine:properties json="{&quot;condition&quot;:{&quot;_type&quot;:&quot;org.uengine.kernel.Evaluate&quot;,&quot;key&quot;:&quot;재시도여부&quot;,&quot;value&quot;:&quot;Y&quot;}}" />
      </bpmn:extensionElements>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${재시도여부 == "Y"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_A08" sourceRef="Task_AuthRetry" targetRef="Task_CancelNotice" name="취소">
      <bpmn:extensionElements>
        <uengine:properties json="{&quot;condition&quot;:{&quot;_type&quot;:&quot;org.uengine.kernel.Evaluate&quot;,&quot;key&quot;:&quot;재시도여부&quot;,&quot;value&quot;:&quot;N&quot;}}" />
      </bpmn:extensionElements>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${재시도여부 == "N"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_A09" sourceRef="Gw_AuthOk" targetRef="Task_PrivacyConsent" name="정상">
      <bpmn:extensionElements>
        <uengine:properties json="{&quot;condition&quot;:{&quot;_type&quot;:&quot;org.uengine.kernel.Evaluate&quot;,&quot;key&quot;:&quot;본인인증결과&quot;,&quot;value&quot;:&quot;정상&quot;}}" />
      </bpmn:extensionElements>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${본인인증결과 == "정상"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_A10" sourceRef="Task_PrivacyConsent" targetRef="Gw_Consent" />
    <bpmn:sequenceFlow id="Flow_A11" sourceRef="Gw_Consent" targetRef="Svc_OpenAccount" name="Y">
      <bpmn:extensionElements>
        <uengine:properties json="{&quot;condition&quot;:{&quot;_type&quot;:&quot;org.uengine.kernel.Evaluate&quot;,&quot;key&quot;:&quot;개인정보동의여부&quot;,&quot;value&quot;:&quot;Y&quot;}}" />
      </bpmn:extensionElements>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${개인정보동의여부 == "Y"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_A12" sourceRef="Gw_Consent" targetRef="Task_CancelNotice" name="N">
      <bpmn:extensionElements>
        <uengine:properties json="{&quot;condition&quot;:{&quot;_type&quot;:&quot;org.uengine.kernel.Evaluate&quot;,&quot;key&quot;:&quot;개인정보동의여부&quot;,&quot;value&quot;:&quot;N&quot;}}" />
      </bpmn:extensionElements>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${개인정보동의여부 == "N"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_A13" sourceRef="Svc_OpenAccount" targetRef="End_AccountDone" />
    <bpmn:sequenceFlow id="Flow_A14" sourceRef="Task_CancelNotice" targetRef="End_AccountCancel" />
  </bpmn:process>
