      </bpmn:extensionElements>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${본인인증결과 == "실패"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_A07" sourceRef="Task_AuthRetry" targetRef="Svc_PhoneAuth" name="재시도">
