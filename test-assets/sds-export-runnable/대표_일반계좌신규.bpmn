<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:uengine="http://uengine" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Process_NewDepositAccount" targetNamespace="http://uengine.org/sds/representative">
  <bpmn:process id="Process_NewDepositAccount" name="일반계좌신규" isExecutable="true">
    <bpmn:extensionElements>
      <uengine:properties json="{&quot;definitionName&quot;:&quot;일반계좌신규&quot;,&quot;version&quot;:&quot;1.0&quot;,&quot;shortDescription&quot;:{&quot;text&quot;:&quot;분기 시뮬레이션 실행용 대표 프로세스&quot;}}">
        <uengine:variable name="개인정보동의여부" type="Text" />
        <uengine:variable name="본인인증결과" type="Text" />
        <uengine:variable name="신규고객여부" type="Text" />
        <uengine:variable name="재시도여부" type="Text" />
      </uengine:properties>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_Process_NewDepositAccount">
      <bpmn:lane id="Lane_1" name="고객">
        <bpmn:flowNodeRef>Start_Account</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="영업점">
        <bpmn:flowNodeRef>Task_AccountConsult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_NewCustomer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_AuthOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AuthRetry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrivacyConsent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Consent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CancelNotice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_AccountCancel</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="외부 인증/코어뱅킹 시스템">
        <bpmn:flowNodeRef>Svc_PhoneAuth</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Svc_OpenAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_AccountDone</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Account" name="상담 시작">
      <bpmn:extensionElements>
        <uengine:properties json="{&quot;checkpoints&quot;:[],&quot;attachments&quot;:[],&quot;taskLink&quot;:&quot;&quot;,&quot;role&quot;:&quot;고객&quot;,&quot;process&quot;:&quot;Process_NewDepositAccount&quot;,&quot;inputData&quot;:[],&quot;outputData&quot;:[],&quot;properties&quot;:&quot;{}&quot;,&quot;duration&quot;:5,&quot;tool&quot;:&quot;formHandler:defaultform&quot;}" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_A01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_AccountConsult" name="상담/권유(방문판매)">
      <bpmn:extensionElements>
        <uengine:properties json="{&quot;checkpoints&quot;:[],&quot;attachments&quot;:[],&quot;taskLink&quot;:&quot;&quot;,&quot;role&quot;:&quot;영업점&quot;,&quot;process&quot;:&quot;Process_NewDepositAccount&quot;,&quot;inputData&quot;:[],&quot;outputData&quot;:[],&quot;properties&quot;:&quot;{}&quot;,&quot;duration&quot;:5,&quot;tool&quot;:&quot;formHandler:일반계좌_상담권유&quot;,&quot;eventSynchronization&quot;:{&quot;mappingContext&quot;:{&quot;mappingElements&quot;:[{&quot;argument&quot;:{&quot;text&quot;:&quot;신규고객여부&quot;},&quot;direction&quot;:&quot;out&quot;,&quot;variable&quot;:{&quot;name&quot;:&quot;[Arguments].신규고객여부&quot;},&quot;isKey&quot;:false}]}}}" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A01</bpmn:incoming>
      <bpmn:outgoing>Flow_A02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_NewCustomer" name="신규고객 여부">
      <bpmn:extensionElements>
        <uengine:properties json="{&quot;checkpoints&quot;:[],&quot;attachments&quot;:[],&quot;taskLink&quot;:&quot;&quot;,&quot;role&quot;:&quot;영업점&quot;,&quot;process&quot;:&quot;Process_NewDepositAccount&quot;,&quot;inputData&quot;:[],&quot;outputData&quot;:[],&quot;properties&quot;:&quot;{}&quot;,&quot;duration&quot;:5,&quot;tool&quot;:&quot;formHandler:defaultform&quot;}" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A02</bpmn:incoming>
      <bpmn:outgoing>Flow_A03</bpmn:outgoing>
      <bpmn:outgoing>Flow_A04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Svc_PhoneAuth" name="휴대폰 본인인증">
      <bpmn:extensionElements>
        <uengine:properties json="{&quot;checkpoints&quot;:[&quot;테스트 응답 입력&quot;],&quot;attachments&quot;:[],&quot;taskLink&quot;:&quot;&quot;,&quot;role&quot;:&quot;외부 인증/코어뱅킹 시스템&quot;,&quot;process&quot;:&quot;Process_NewDepositAccount&quot;,&quot;inputData&quot;:[],&quot;outputData&quot;:[],&quot;properties&quot;:&quot;{}&quot;,&quot;duration&quot;:5,&quot;tool&quot;:&quot;formHandler:일반계좌_휴대폰본인인증&quot;,&quot;eventSynchronization&quot;:{&quot;mappingContext&quot;:{&quot;mappingElements&quot;:[{&quot;argument&quot;:{&quot;text&quot;:&quot;본인인증결과&quot;},&quot;direction&quot;:&quot;out&quot;,&quot;variable&quot;:{&quot;name&quot;:&quot;[Arguments].본인인증결과&quot;},&quot;isKey&quot;:false}]}}}" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A03</bpmn:incoming>
      <bpmn:incoming>Flow_A07</bpmn:incoming>
      <bpmn:outgoing>Flow_A05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_AuthOk" name="본인인증 결과">
      <bpmn:extensionElements>
        <uengine:properties json="{&quot;checkpoints&quot;:[],&quot;attachments&quot;:[],&quot;taskLink&quot;:&quot;&quot;,&quot;role&quot;:&quot;영업점&quot;,&quot;process&quot;:&quot;Process_NewDepositAccount&quot;,&quot;inputData&quot;:[],&quot;outputData&quot;:[],&quot;properties&quot;:&quot;{}&quot;,&quot;duration&quot;:5,&quot;tool&quot;:&quot;formHandler:defaultform&quot;}" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A05</bpmn:incoming>
      <bpmn:outgoing>Flow_A06</bpmn:outgoing>
      <bpmn:outgoing>Flow_A09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_AuthRetry" name="본인확인 재요청">
      <bpmn:extensionElements>
        <uengine:properties json="{&quot;checkpoints&quot;:[],&quot;attachments&quot;:[],&quot;taskLink&quot;:&quot;&quot;,&quot;role&quot;:&quot;영업점&quot;,&quot;process&quot;:&quot;Process_NewDepositAccount&quot;,&quot;inputData&quot;:[],&quot;outputData&quot;:[],&quot;properties&quot;:&quot;{}&quot;,&quot;duration&quot;:5,&quot;tool&quot;:&quot;formHandler:일반계좌_본인확인재요청&quot;,&quot;eventSynchronization&quot;:{&quot;mappingContext&quot;:{&quot;mappingElements&quot;:[{&quot;argument&quot;:{&quot;text&quot;:&quot;재시도여부&quot;},&quot;direction&quot;:&quot;out&quot;,&quot;variable&quot;:{&quot;name&quot;:&quot;[Arguments].재시도여부&quot;},&quot;isKey&quot;:false}]}}}" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A06</bpmn:incoming>
      <bpmn:outgoing>Flow_A07</bpmn:outgoing>
      <bpmn:outgoing>Flow_A08</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_PrivacyConsent" name="개인정보 이용동의서">
      <bpmn:extensionElements>
        <uengine:properties json="{&quot;checkpoints&quot;:[],&quot;attachments&quot;:[],&quot;taskLink&quot;:&quot;&quot;,&quot;role&quot;:&quot;영업점&quot;,&quot;process&quot;:&quot;Process_NewDepositAccount&quot;,&quot;inputData&quot;:[],&quot;outputData&quot;:[],&quot;properties&quot;:&quot;{}&quot;,&quot;duration&quot;:5,&quot;tool&quot;:&quot;formHandler:일반계좌_개인정보동의&quot;,&quot;eventSynchronization&quot;:{&quot;mappingContext&quot;:{&quot;mappingElements&quot;:[{&quot;argument&quot;:{&quot;text&quot;:&quot;개인정보동의여부&quot;},&quot;direction&quot;:&quot;out&quot;,&quot;variable&quot;:{&quot;name&quot;:&quot;[Arguments].개인정보동의여부&quot;},&quot;isKey&quot;:false}]}}}" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A04</bpmn:incoming>
      <bpmn:incoming>Flow_A09</bpmn:incoming>
      <bpmn:outgoing>Flow_A10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_Consent" name="개인정보 동의 여부">
      <bpmn:extensionElements>
        <uengine:properties json="{&quot;checkpoints&quot;:[],&quot;attachments&quot;:[],&quot;taskLink&quot;:&quot;&quot;,&quot;role&quot;:&quot;영업점&quot;,&quot;process&quot;:&quot;Process_NewDepositAccount&quot;,&quot;inputData&quot;:[],&quot;outputData&quot;:[],&quot;properties&quot;:&quot;{}&quot;,&quot;duration&quot;:5,&quot;tool&quot;:&quot;formHandler:defaultform&quot;}" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A10</bpmn:incoming>
      <bpmn:outgoing>Flow_A11</bpmn:outgoing>
      <bpmn:outgoing>Flow_A12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Svc_OpenAccount" name="계좌 신규 등록">
      <bpmn:extensionElements>
        <uengine:properties json="{&quot;checkpoints&quot;:[&quot;테스트 응답 입력&quot;],&quot;attachments&quot;:[],&quot;taskLink&quot;:&quot;&quot;,&quot;role&quot;:&quot;외부 인증/코어뱅킹 시스템&quot;,&quot;process&quot;:&quot;Process_NewDepositAccount&quot;,&quot;inputData&quot;:[],&quot;outputData&quot;:[],&quot;properties&quot;:&quot;{}&quot;,&quot;duration&quot;:5,&quot;tool&quot;:&quot;formHandler:일반계좌_계좌신규등록&quot;,&quot;eventSynchronization&quot;:{&quot;mappingContext&quot;:{&quot;mappingElements&quot;:[{&quot;argument&quot;:{&quot;text&quot;:&quot;계좌개설결과&quot;},&quot;direction&quot;:&quot;out&quot;,&quot;variable&quot;:{&quot;name&quot;:&quot;[Arguments].계좌개설결과&quot;},&quot;isKey&quot;:false}]}}}" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A11</bpmn:incoming>
      <bpmn:outgoing>Flow_A13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_CancelNotice" name="개설취소 통보">
      <bpmn:extensionElements>
        <uengine:properties json="{&quot;checkpoints&quot;:[],&quot;attachments&quot;:[],&quot;taskLink&quot;:&quot;&quot;,&quot;role&quot;:&quot;영업점&quot;,&quot;process&quot;:&quot;Process_NewDepositAccount&quot;,&quot;inputData&quot;:[],&quot;outputData&quot;:[],&quot;properties&quot;:&quot;{}&quot;,&quot;duration&quot;:5,&quot;tool&quot;:&quot;formHandler:일반계좌_개설취소통보&quot;}" />
