      </bpmn:extensionElements>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${신규고객여부 == "N"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_A05" sourceRef="Svc_PhoneAuth" targetRef="Gw_AuthOk" />
    <bpmn:sequenceFlow id="Flow_A06" sourceRef="Gw_AuthOk" targetRef="Task_AuthRetry" name="실패">
