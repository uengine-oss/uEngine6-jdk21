        <dc:Bounds x="610" y="291" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_GiveTerms_di" bpmnElement="Task_GiveTerms">
        <dc:Bounds x="745" y="276" width="100" height="80" />
      </bpmndi:BPMNShape>
