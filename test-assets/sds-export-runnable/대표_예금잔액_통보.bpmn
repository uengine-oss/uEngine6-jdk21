<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:uengine="http://uengine" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Process_DepositBalanceNotice" targetNamespace="http://uengine.org/sds/representative">
  <bpmn:process id="Process_DepositBalanceNotice" name="예금잔액 통보" isExecutable="true">
    <bpmn:extensionElements>
      <uengine:properties json="{&quot;definitionName&quot;:&quot;예금잔액 통보&quot;,&quot;version&quot;:&quot;1.0&quot;,&quot;shortDescription&quot;:{&quot;text&quot;:&quot;분기 시뮬레이션 실행용 대표 프로세스&quot;}}">
        <uengine:variable name="DM반송여부" type="Text" />
        <uengine:variable name="예금잔액이상여부" type="Text" />
        <uengine:variable name="일괄발송대상여부" type="Text" />
      </uengine:properties>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_Process_DepositBalanceNotice">
      <bpmn:lane id="Lane_1" name="본부">
        <bpmn:flowNodeRef>Start_BalanceNotice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PostTargets</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_BatchTarget</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="영업점">
        <bpmn:flowNodeRef>Task_CheckBalance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IndividualDm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Returned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmAddress</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_BalanceIssue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReportIssue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Normal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_IssueReported</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="발송 시스템">
        <bpmn:flowNodeRef>Svc_BatchDm</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_4" name="고객">
        <bpmn:flowNodeRef>Task_CustomerConfirm</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_BalanceNotice" name="통보 준비 시작">
      <bpmn:extensionElements>
        <uengine:properties json="{&quot;checkpoints&quot;:[],&quot;attachments&quot;:[],&quot;taskLink&quot;:&quot;&quot;,&quot;role&quot;:&quot;본부&quot;,&quot;process&quot;:&quot;Process_DepositBalanceNotice&quot;,&quot;inputData&quot;:[],&quot;outputData&quot;:[],&quot;properties&quot;:&quot;{}&quot;,&quot;duration&quot;:5,&quot;tool&quot;:&quot;formHandler:defaultform&quot;}" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_B01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_PostTargets" name="예금잔액 통보 대상 게시">
      <bpmn:extensionElements>
        <uengine:properties json="{&quot;checkpoints&quot;:[],&quot;attachments&quot;:[],&quot;taskLink&quot;:&quot;&quot;,&quot;role&quot;:&quot;본부&quot;,&quot;process&quot;:&quot;Process_DepositBalanceNotice&quot;,&quot;inputData&quot;:[],&quot;outputData&quot;:[],&quot;properties&quot;:&quot;{}&quot;,&quot;duration&quot;:5,&quot;tool&quot;:&quot;formHandler:예금잔액_대상게시&quot;,&quot;eventSynchronization&quot;:{&quot;mappingContext&quot;:{&quot;mappingElements&quot;:[{&quot;argument&quot;:{&quot;text&quot;:&quot;일괄발송대상여부&quot;},&quot;direction&quot;:&quot;out&quot;,&quot;variable&quot;:{&quot;name&quot;:&quot;[Arguments].일괄발송대상여부&quot;},&quot;isKey&quot;:false}]}}}" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_B01</bpmn:incoming>
      <bpmn:outgoing>Flow_B02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_BatchTarget" name="본부 일괄발송 대상 여부">
      <bpmn:extensionElements>
        <uengine:properties json="{&quot;checkpoints&quot;:[],&quot;attachments&quot;:[],&quot;taskLink&quot;:&quot;&quot;,&quot;role&quot;:&quot;본부&quot;,&quot;process&quot;:&quot;Process_DepositBalanceNotice&quot;,&quot;inputData&quot;:[],&quot;outputData&quot;:[],&quot;properties&quot;:&quot;{}&quot;,&quot;duration&quot;:5,&quot;tool&quot;:&quot;formHandler:defaultform&quot;}" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_B02</bpmn:incoming>
      <bpmn:outgoing>Flow_B03</bpmn:outgoing>
      <bpmn:outgoing>Flow_B04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Svc_BatchDm" name="일괄 DM 발송">
      <bpmn:extensionElements>
        <uengine:properties json="{&quot;checkpoints&quot;:[&quot;테스트 응답 입력&quot;],&quot;attachments&quot;:[],&quot;taskLink&quot;:&quot;&quot;,&quot;role&quot;:&quot;발송 시스템&quot;,&quot;process&quot;:&quot;Process_DepositBalanceNotice&quot;,&quot;inputData&quot;:[],&quot;outputData&quot;:[],&quot;properties&quot;:&quot;{}&quot;,&quot;duration&quot;:5,&quot;tool&quot;:&quot;formHandler:예금잔액_일괄DM발송&quot;,&quot;eventSynchronization&quot;:{&quot;mappingContext&quot;:{&quot;mappingElements&quot;:[{&quot;argument&quot;:{&quot;text&quot;:&quot;DM반송여부&quot;},&quot;direction&quot;:&quot;out&quot;,&quot;variable&quot;:{&quot;name&quot;:&quot;[Arguments].DM반송여부&quot;},&quot;isKey&quot;:false}]}}}" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_B03</bpmn:incoming>
      <bpmn:outgoing>Flow_B05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_CheckBalance" name="이상 유무 확인">
      <bpmn:extensionElements>
        <uengine:properties json="{&quot;checkpoints&quot;:[],&quot;attachments&quot;:[],&quot;taskLink&quot;:&quot;&quot;,&quot;role&quot;:&quot;영업점&quot;,&quot;process&quot;:&quot;Process_DepositBalanceNotice&quot;,&quot;inputData&quot;:[],&quot;outputData&quot;:[],&quot;properties&quot;:&quot;{}&quot;,&quot;duration&quot;:5,&quot;tool&quot;:&quot;formHandler:예금잔액_이상유무확인&quot;,&quot;eventSynchronization&quot;:{&quot;mappingContext&quot;:{&quot;mappingElements&quot;:[{&quot;argument&quot;:{&quot;text&quot;:&quot;예금잔액이상여부&quot;},&quot;direction&quot;:&quot;out&quot;,&quot;variable&quot;:{&quot;name&quot;:&quot;[Arguments].예금잔액이상여부&quot;},&quot;isKey&quot;:false}]}}}" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_B04</bpmn:incoming>
      <bpmn:outgoing>Flow_B06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_IndividualDm" name="개별 DM 발송">
      <bpmn:extensionElements>
        <uengine:properties json="{&quot;checkpoints&quot;:[],&quot;attachments&quot;:[],&quot;taskLink&quot;:&quot;&quot;,&quot;role&quot;:&quot;영업점&quot;,&quot;process&quot;:&quot;Process_DepositBalanceNotice&quot;,&quot;inputData&quot;:[],&quot;outputData&quot;:[],&quot;properties&quot;:&quot;{}&quot;,&quot;duration&quot;:5,&quot;tool&quot;:&quot;formHandler:예금잔액_개별DM발송&quot;,&quot;eventSynchronization&quot;:{&quot;mappingContext&quot;:{&quot;mappingElements&quot;:[{&quot;argument&quot;:{&quot;text&quot;:&quot;DM반송여부&quot;},&quot;direction&quot;:&quot;out&quot;,&quot;variable&quot;:{&quot;name&quot;:&quot;[Arguments].DM반송여부&quot;},&quot;isKey&quot;:false}]}}}" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_B06</bpmn:incoming>
      <bpmn:incoming>Flow_B09</bpmn:incoming>
      <bpmn:outgoing>Flow_B07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_Returned" name="DM 반송 여부">
      <bpmn:extensionElements>
        <uengine:properties json="{&quot;checkpoints&quot;:[],&quot;attachments&quot;:[],&quot;taskLink&quot;:&quot;&quot;,&quot;role&quot;:&quot;영업점&quot;,&quot;process&quot;:&quot;Process_DepositBalanceNotice&quot;,&quot;inputData&quot;:[],&quot;outputData&quot;:[],&quot;properties&quot;:&quot;{}&quot;,&quot;duration&quot;:5,&quot;tool&quot;:&quot;formHandler:defaultform&quot;}" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_B05</bpmn:incoming>
      <bpmn:incoming>Flow_B07</bpmn:incoming>
      <bpmn:outgoing>Flow_B08</bpmn:outgoing>
      <bpmn:outgoing>Flow_B10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ConfirmAddress" name="반송주소 확인">
      <bpmn:extensionElements>
        <uengine:properties json="{&quot;checkpoints&quot;:[],&quot;attachments&quot;:[],&quot;taskLink&quot;:&quot;&quot;,&quot;role&quot;:&quot;영업점&quot;,&quot;process&quot;:&quot;Process_DepositBalanceNotice&quot;,&quot;inputData&quot;:[],&quot;outputData&quot;:[],&quot;properties&quot;:&quot;{}&quot;,&quot;duration&quot;:5,&quot;tool&quot;:&quot;formHandler:예금잔액_반송주소확인&quot;}" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_B08</bpmn:incoming>
      <bpmn:outgoing>Flow_B09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_CustomerConfirm" name="DM 수령 및 확인">
      <bpmn:extensionElements>
        <uengine:properties json="{&quot;checkpoints&quot;:[],&quot;attachments&quot;:[],&quot;taskLink&quot;:&quot;&quot;,&quot;role&quot;:&quot;고객&quot;,&quot;process&quot;:&quot;Process_DepositBalanceNotice&quot;,&quot;inputData&quot;:[],&quot;outputData&quot;:[],&quot;properties&quot;:&quot;{}&quot;,&quot;duration&quot;:5,&quot;tool&quot;:&quot;formHandler:예금잔액_DM수령확인&quot;,&quot;eventSynchronization&quot;:{&quot;mappingContext&quot;:{&quot;mappingElements&quot;:[{&quot;argument&quot;:{&quot;text&quot;:&quot;예금잔액이상여부&quot;},&quot;direction&quot;:&quot;out&quot;,&quot;variable&quot;:{&quot;name&quot;:&quot;[Arguments].예금잔액이상여부&quot;},&quot;isKey&quot;:false}]}}}" />
