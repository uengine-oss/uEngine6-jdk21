      <bpmn:incoming>Flow_B10</bpmn:incoming>
      <bpmn:outgoing>Flow_B11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_BalanceIssue" name="예금잔액 이상 여부">
      <bpmn:extensionElements>
        <uengine:properties json="{&quot;checkpoints&quot;:[],&quot;attachments&quot;:[],&quot;taskLink&quot;:&quot;&quot;,&quot;role&quot;:&quot;영업점&quot;,&quot;process&quot;:&quot;Process_DepositBalanceNotice&quot;,&quot;inputData&quot;:[],&quot;outputData&quot;:[],&quot;properties&quot;:&quot;{}&quot;,&quot;duration&quot;:5,&quot;tool&quot;:&quot;formHandler:defaultform&quot;}" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_B11</bpmn:incoming>
      <bpmn:outgoing>Flow_B12</bpmn:outgoing>
      <bpmn:outgoing>Flow_B13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ReportIssue" name="예금잔액 이상 통보">
      <bpmn:extensionElements>
        <uengine:properties json="{&quot;checkpoints&quot;:[],&quot;attachments&quot;:[],&quot;taskLink&quot;:&quot;&quot;,&quot;role&quot;:&quot;영업점&quot;,&quot;process&quot;:&quot;Process_DepositBalanceNotice&quot;,&quot;inputData&quot;:[],&quot;outputData&quot;:[],&quot;properties&quot;:&quot;{}&quot;,&quot;duration&quot;:5,&quot;tool&quot;:&quot;formHandler:예금잔액_이상통보&quot;}" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_B12</bpmn:incoming>
      <bpmn:outgoing>Flow_B14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Normal" name="통보 완료">
      <bpmn:extensionElements>
        <uengine:properties json="{&quot;checkpoints&quot;:[],&quot;attachments&quot;:[],&quot;taskLink&quot;:&quot;&quot;,&quot;role&quot;:&quot;영업점&quot;,&quot;process&quot;:&quot;Process_DepositBalanceNotice&quot;,&quot;inputData&quot;:[],&quot;outputData&quot;:[],&quot;properties&quot;:&quot;{}&quot;,&quot;duration&quot;:5,&quot;tool&quot;:&quot;formHandler:defaultform&quot;}" />
