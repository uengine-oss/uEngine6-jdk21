      </bpmn:extensionElements>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${일괄발송대상여부 == "N"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_B05" sourceRef="Svc_BatchDm" targetRef="Gw_Returned" />
    <bpmn:sequenceFlow id="Flow_B06" sourceRef="Task_CheckBalance" targetRef="Task_IndividualDm" />
    <bpmn:sequenceFlow id="Flow_B07" sourceRef="Task_IndividualDm" targetRef="Gw_Returned" />
    <bpmn:sequenceFlow id="Flow_B08" sourceRef="Gw_Returned" targetRef="Task_ConfirmAddress" name="Y">
      <bpmn:extensionElements>
        <uengine:properties json="{&quot;condition&quot;:{&quot;_type&quot;:&quot;org.uengine.kernel.Evaluate&quot;,&quot;key&quot;:&quot;DM반송여부&quot;,&quot;value&quot;:&quot;Y&quot;}}" />
      </bpmn:extensionElements>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${DM반송여부 == "Y"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_B09" sourceRef="Task_ConfirmAddress" targetRef="Task_IndividualDm" />
    <bpmn:sequenceFlow id="Flow_B10" sourceRef="Gw_Returned" targetRef="Task_CustomerConfirm" name="N">
      <bpmn:extensionElements>
        <uengine:properties json="{&quot;condition&quot;:{&quot;_type&quot;:&quot;org.uengine.kernel.Evaluate&quot;,&quot;key&quot;:&quot;DM반송여부&quot;,&quot;value&quot;:&quot;N&quot;}}" />
      </bpmn:extensionElements>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${DM반송여부 == "N"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_B11" sourceRef="Task_CustomerConfirm" targetRef="Gw_BalanceIssue" />
    <bpmn:sequenceFlow id="Flow_B12" sourceRef="Gw_BalanceIssue" targetRef="Task_ReportIssue" name="Y">
      <bpmn:extensionElements>
        <uengine:properties json="{&quot;condition&quot;:{&quot;_type&quot;:&quot;org.uengine.kernel.Evaluate&quot;,&quot;key&quot;:&quot;예금잔액이상여부&quot;,&quot;value&quot;:&quot;Y&quot;}}" />
      </bpmn:extensionElements>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${예금잔액이상여부 == "Y"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_B13" sourceRef="Gw_BalanceIssue" targetRef="End_Normal" name="N">
      <bpmn:extensionElements>
        <uengine:properties json="{&quot;condition&quot;:{&quot;_type&quot;:&quot;org.uengine.kernel.Evaluate&quot;,&quot;key&quot;:&quot;예금잔액이상여부&quot;,&quot;value&quot;:&quot;N&quot;}}" />
      </bpmn:extensionElements>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${예금잔액이상여부 == "N"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_B14" sourceRef="Task_ReportIssue" targetRef="End_IssueReported" />
  </bpmn:process>
