      <bpmn:incoming>Flow_B14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_B01" sourceRef="Start_BalanceNotice" targetRef="Task_PostTargets" />
    <bpmn:sequenceFlow id="Flow_B02" sourceRef="Task_PostTargets" targetRef="Gw_BatchTarget" />
    <bpmn:sequenceFlow id="Flow_B03" sourceRef="Gw_BatchTarget" targetRef="Svc_BatchDm" name="Y">
      <bpmn:extensionElements>
        <uengine:properties json="{&quot;condition&quot;:{&quot;_type&quot;:&quot;org.uengine.kernel.Evaluate&quot;,&quot;key&quot;:&quot;일괄발송대상여부&quot;,&quot;value&quot;:&quot;Y&quot;}}" />
      </bpmn:extensionElements>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${일괄발송대상여부 == "Y"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_B04" sourceRef="Gw_BatchTarget" targetRef="Task_CheckBalance" name="N">
