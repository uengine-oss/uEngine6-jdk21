FROM node:8.17.0-buster AS build

WORKDIR /workspace
ENV PHANTOMJS_SKIP_DOWNLOAD=true \
    CHROMEDRIVER_SKIP_DOWNLOAD=true
COPY package.json package-lock.json ./
RUN npm ci --unsafe-perm
COPY . .
RUN npm run build

FROM nginx:1.27-alpine

COPY --from=build /workspace/dist /usr/share/nginx/html/admin
COPY docker/analytics-nginx.conf /etc/nginx/conf.d/default.conf
COPY docker/analytics-entrypoint.sh /docker-entrypoint-analytics.sh
RUN chmod +x /docker-entrypoint-analytics.sh

EXPOSE 8082
ENTRYPOINT ["/docker-entrypoint-analytics.sh"]
